# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- 操作系统 ---
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# --- IDE / 编辑器 ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# --- 日志与临时文件 ---
*.log
logs/
tmp/
temp/

# --- 工具链缓存 ---
.eslintcache
.stylelintcache
.prettiercache
.cache/
.parcel-cache/
.turbo/
.swc/
dist/

# --- pnpm ---
.pnpm-store/

# --- local sqlite ---
/data/

# --- 测试 / E2E 产物（后续若引入测试）---
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- 密钥与本地凭证（补充 .env*）---
*.local.pem
*.key
credentials.json
secrets.json
